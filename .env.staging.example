# ════════════════════════════════════════════════════════════════════
# ELITE BCN — STAGING environment (names and placeholders only)
#
# Set these in the Vercel project "elitebcn-staging", scope "Preview".
# NEVER copy a value from the production project. Every secret here must be
# generated fresh for staging. Nothing real belongs in this file or in Git.
# ════════════════════════════════════════════════════════════════════

# ─── Identity of this environment (required) ───────────────────────
# Tells the application it is NOT production. With this set, the app refuses to
# start if any database variable points at the production database.
APP_ENV="staging"

# ─── Database: the separate Neon STAGING project ───────────────────
# The database NAME must contain the word "staging" (use elitebcn_staging): the app and the
# staging scripts refuse to start otherwise.
# Create a new Neon project named elitebcn-staging. Do not branch from production:
# a branch copies real customers. Use these, from that project only.
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@STAGING-HOST-pooler.neon.tech/elitebcn_staging?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@STAGING-HOST.neon.tech/elitebcn_staging?sslmode=require"

# ─── Auth: generate NEW values (openssl rand -base64 48) ───────────
NEXTAUTH_SECRET="generate-a-new-one-for-staging"
NEXTAUTH_URL="https://YOUR-STAGING-HOSTNAME"
# Mobile bearer tokens. Its own secret, at least 32 characters, never NEXTAUTH_SECRET.
MOBILE_JWT_SECRET="generate-a-new-one-for-staging-mobile"

# ─── Crons: staging deploys as Preview, so Vercel never runs crons there ──
# Still set a staging value, so a manual call cannot use the production one.
CRON_SECRET="generate-a-new-one-for-staging-cron"

# ─── Web push: generate a NEW pair (npx web-push generate-vapid-keys) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY="new-staging-public-key"
VAPID_PRIVATE_KEY="new-staging-private-key"
VAPID_SUBJECT="mailto:staging@elitebcn.info"

# ─── Third-party services: leave UNSET, or use sandbox/test accounts ──
# Unset means the feature reports "skipped" instead of acting on real people.
#   SUMUP_API_KEY / SUMUP_MERCHANT_CODE   → only a SumUp sandbox key, or unset
#   RESEND_API_KEY                        → unset (no email leaves staging)
#   TWILIO_*                              → unset (no SMS)
#   WA_TOKEN / WA_PHONE_ID                → a separate WhatsApp TEST number, or unset
#   AERODATABOX_KEY                       → unset, or a free-tier key of its own

# ─── Mobile app version gate (optional until the first store release) ──
# MOBILE_CUSTOMER_IOS_MIN_VERSION="1.0.0"
# MOBILE_CUSTOMER_IOS_LATEST_VERSION="1.0.0"
# MOBILE_CUSTOMER_IOS_STORE_URL=""
