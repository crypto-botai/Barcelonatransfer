{
  "framework": "nextjs",
  "buildCommand": "rm -rf .next/cache && npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": ["fra1"],
  "crons": [
    { "path": "/api/cron/daily",              "schedule": "0 8 * * *"   },
    { "path": "/api/cron/orchestrator",       "schedule": "0 6 * * *"   },
    { "path": "/api/cron/payment-reconcile",  "schedule": "*/10 * * * *" },
    { "path": "/api/cron/abandoned-check",    "schedule": "*/30 * * * *" },
    { "path": "/api/cron/pickup-reminder",    "schedule": "0 */6 * * *" },
    { "path": "/api/cron/review-request",     "schedule": "0 12 * * *"  }
  ]
}
