{
  "framework": "nextjs",
  "buildCommand": "rm -rf .next/cache && SKIP_IMAGE_CHECK=1 npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": ["fra1"],
  "crons": [
    { "path": "/api/cron/daily",        "schedule": "0 8 * * *"  },
    { "path": "/api/cron/orchestrator", "schedule": "0 6 * * *"  }
  ]
}
