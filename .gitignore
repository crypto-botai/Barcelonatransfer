.env.production.local
# .env.production was tracked until 8 Sep 2026 and carried live credentials —
# the database URL and password, NEXTAUTH_SECRET, the Google OAuth secret, and
# the Resend and SumUp API keys. The pattern above only caught the ".local"
# suffix, so the production file slipped through. The real values live in
# Vercel's environment settings; nothing secret belongs in the repo.
.env.production
.env.*.production

# vercel
.vercel
.env.vercel-live
.env.vercel*

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw Search Console exports — never published.
#
# This repository is public. The exports carry the full query list and the
# country breakdown, which is commercial intelligence and hands a competitor
# the keyword research for free. Analysis and conclusions get committed; the
# raw files stay on the machine that downloaded them.
/seo-data/

# prisma
prisma/migrations/
.env*.local

# temporary debug scripts — never commit
tmp_*.js
tmp_*.ts

# Local diagnostic scripts — never part of the app
scratch/
